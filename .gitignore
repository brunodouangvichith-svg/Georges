# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Env
.env
infra/.env

# Jeu d'entraînement dérivé (Phase 2) — régénérable via
# engine/build_training_set.py, volontairement non versionné (dépendant des
# données du moment).
engine/data/

# Modèles *candidats* (engine/train_confidence_model.py) — jamais versionnés :
# un candidat n'est qu'une proposition en attente de revue humaine avant
# promotion (voir CLAUDE.md, section "Auto-learn"). Le modèle *promu*
# (directement sous engine/models/, pas dans ce sous-dossier) EST versionné
# depuis ce changement — c'est ce qui permet au workflow GitHub Actions
# programmé (checkout Git vierge à chaque exécution) d'avoir accès à un vrai
# modèle entraîné plutôt que de retomber systématiquement sur l'heuristique.
engine/models/candidates/

# Node / web (voir aussi web/.gitignore)
web/node_modules/
web/dist/

# Cloudflare Worker (cloudflare-cron/, voir CLAUDE.md section "Cron
# Cloudflare") -- état local de wrangler et dépendances npm si jamais
# installées autrement que via `npx`, jamais le secret CRON_SECRET lui-même
# (jamais écrit dans un fichier de ce dossier, voir cloudflare-cron/README.md).
cloudflare-cron/node_modules/
cloudflare-cron/.wrangler/
cloudflare-cron/.dev.vars

# OS
.DS_Store
Thumbs.db

# Logs de scripts/dev-up.ps1
.dev-logs/

# Configuration Claude Code locale/personnelle (hooks, permissions propres à cette machine)
.claude/settings.local.json
