# Copie ce fichier en `.env` (même dossier) pour surcharger l'URL de l'API.
# Valeur par défaut si absent : http://localhost:8000 (voir src/api/client.js).
VITE_API_BASE_URL=http://localhost:8000

# Projet Supabase utilisé comme fournisseur d'identité (Phase 9 — portail
# d'accès simple, voir CLAUDE.md section Auth). Pas de valeur par défaut
# sensée pour ces deux-là (voir src/api/supabaseClient.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
